{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    "paths": {
      "yatta/runtime": ["./core_runtime/index.ts"],
      "yatta/cluster": ["./core_runtime/cluster.ts"]
    }
  },
  // Scope typechecking to the framework's own source. Scratch projects created
  // with `yatta init` live at the repo root and declare their own module
  // augmentations (e.g. `declare module "yatta/db"`), which would otherwise
  // collide with the framework's.
  "include": ["src/**/*", "core_runtime/**/*"],
  "exclude": ["node_modules", "dist"]
}
